{
  "type": "Panel",
  "name": "ProductionQueue",
  "anchor": "Fill",
  "hitTest": false,
  "visibleWhen": "queue.visible",
  "children": [
    {
      "type": "Text",
      "name": "QueueTitle",
      "text": "Production queue",
      "font": "Body",
      "fontSize": 14,
      "color": "MutedText",
      "position": [
        0,
        0
      ],
      "size": [
        192,
        20
      ],
      "wrap": true,
      "maxLines": 1
    },
    {
      "type": "HBox",
      "name": "LowPowerMarker",
      "anchor": "TopRight",
      "position": [
        0,
        0
      ],
      "spacing": 4,
      "visibleWhen": "queue.lowPower",
      "children": [
        {
          "type": "Image",
          "name": "LowPowerIcon",
          "sprite": "Icon.LowPowerSlow",
          "color": "Warning",
          "size": [
            18,
            18
          ]
        },
        {
          "type": "Text",
          "name": "LowPowerText",
          "text": "LOW POWER - SLOW",
          "font": "Body",
          "fontSize": 14,
          "color": "Warning",
          "position": [
            0,
            0
          ],
          "size": [
            140,
            20
          ],
          "align": "Right",
          "maxLines": 1
        }
      ]
    },
    {
      "type": "HBox",
      "name": "QueueItems",
      "position": [
        0,
        24
      ],
      "size": [
        400,
        48
      ],
      "spacing": 40,
      "repeat": "queue",
      "count": 5,
      "template": {
        "type": "Button",
        "name": "QueueItem",
        "sprite": "QueueSlot",
        "action": "CancelQueueItem",
        "size": [
          48,
          48
        ],
        "bind": {
          "enabled": "item.name",
          "selected": "item.isActive"
        },
        "children": [
          {
            "type": "Image",
            "name": "QueueItemIcon",
            "sprite": "Icon.Placeholder",
            "anchor": "Top",
            "position": [
              0,
              4
            ],
            "size": [
              30,
              30
            ],
            "visibleWhen": "!item.empty",
            "bind": {
              "sprite": "item.icon"
            }
          },
          {
            "type": "Text",
            "name": "QueueItemTime",
            "text": "{item.timeLeft}",
            "font": "Number",
            "fontSize": 14,
            "anchor": "Top",
            "position": [
              0,
              25
            ],
            "size": [
              44,
              18
            ],
            "align": "Center",
            "maxLines": 1,
            "visibleWhen": "item.isActive"
          },
          {
            "type": "ProgressBar",
            "name": "QueueItemProgress",
            "sprite": "ProgressBar",
            "fillSprite": "ProgressFill",
            "fillColor": "Accent",
            "anchor": "Top",
            "position": [
              0,
              42
            ],
            "size": [
              40,
              3
            ],
            "visibleWhen": "item.isActive",
            "bind": {
              "progress": "item.progress"
            }
          }
        ]
      }
    }
  ]
}
