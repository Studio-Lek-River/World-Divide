{
  "type": "Panel",
  "name": "ResourceBar",
  "anchor": "Fill",
  "sprite": "ResourceStrip",
  "padding": [
    12,
    4,
    12,
    4
  ],
  "children": [
    {
      "type": "HBox",
      "name": "ResourcePlates",
      "anchor": "LeftStretch",
      "spacing": 8,
      "align": "Center",
      "children": [
        {
          "type": "Panel",
          "name": "Power",
          "size": [
            306,
            32
          ],
          "sprite": "ResourceSlot",
          "padding": [
            12,
            0,
            12,
            0
          ],
          "children": [
            {
              "type": "HBox",
              "name": "PowerContents",
              "anchor": "LeftStretch",
              "spacing": 8,
              "align": "Center",
              "children": [
                {
                  "type": "Panel",
                  "name": "PowerIconCell",
                  "size": [
                    20,
                    20
                  ],
                  "hitTest": false,
                  "children": [
                    {
                      "type": "Image",
                      "name": "PowerIcon",
                      "sprite": "Icon.Power",
                      "size": [
                        20,
                        20
                      ],
                      "color": "#75B9DF",
                      "visibleWhen": "!player.power.low",
                      "bind": {
                        "color": "player.power.color"
                      }
                    },
                    {
                      "type": "Image",
                      "name": "PowerLowIcon",
                      "sprite": "Icon.PowerLow",
                      "size": [
                        20,
                        20
                      ],
                      "color": "#F1BC65",
                      "visibleWhen": "player.power.low",
                      "bind": {
                        "color": "player.power.color"
                      }
                    }
                  ]
                },
                {
                  "type": "Text",
                  "name": "PowerLabel",
                  "text": "POWER",
                  "font": "Body",
                  "fontSize": 16,
                  "color": "#B5C0CE",
                  "size": [
                    64,
                    22
                  ],
                  "wrap": false,
                  "maxLines": 1
                },
                {
                  "type": "Panel",
                  "name": "PowerBarCell",
                  "size": [
                    90,
                    10
                  ],
                  "hitTest": false,
                  "children": [
                    {
                      "type": "ProgressBar",
                      "name": "PowerBar",
                      "anchor": "Fill",
                      "sprite": "PowerBar",
                      "fillSprite": "PowerFill",
                      "fillColor": "#75B9DF",
                      "bind": {
                        "progress": "player.power.ratio"
                      },
                      "visibleWhen": "!player.power.low"
                    },
                    {
                      "type": "ProgressBar",
                      "name": "PowerBarLow",
                      "anchor": "Fill",
                      "sprite": "PowerBar",
                      "fillSprite": "PowerFill",
                      "fillColor": "#F1BC65",
                      "bind": {
                        "progress": "player.power.ratio"
                      },
                      "visibleWhen": "player.power.low"
                    }
                  ]
                },
                {
                  "type": "Text",
                  "name": "PowerText",
                  "text": "{player.power.produced} / {player.power.consumed}",
                  "font": "Number",
                  "fontSize": 16,
                  "color": "#E6E9EE",
                  "size": [
                    84,
                    22
                  ],
                  "wrap": false,
                  "maxLines": 1,
                  "bind": {
                    "color": "player.power.color"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Panel",
          "name": "Credits",
          "size": [
            222,
            32
          ],
          "sprite": "ResourceSlot",
          "padding": [
            12,
            0,
            12,
            0
          ],
          "children": [
            {
              "type": "HBox",
              "name": "CreditsContents",
              "anchor": "LeftStretch",
              "spacing": 8,
              "align": "Center",
              "children": [
                {
                  "type": "Image",
                  "name": "CreditsIcon",
                  "sprite": "Icon.Credits",
                  "size": [
                    20,
                    20
                  ],
                  "color": "#75B9DF"
                },
                {
                  "type": "Text",
                  "name": "CreditsLabel",
                  "text": "CREDITS",
                  "font": "Body",
                  "fontSize": 16,
                  "color": "#B5C0CE",
                  "size": [
                    70,
                    22
                  ],
                  "wrap": false,
                  "maxLines": 1
                },
                {
                  "type": "Text",
                  "name": "CreditsText",
                  "text": "{player.credits}",
                  "font": "Number",
                  "fontSize": 16,
                  "color": "#E6E9EE",
                  "size": [
                    76,
                    22
                  ],
                  "wrap": false,
                  "maxLines": 1
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "SuperweaponReserve",
      "anchor": "Right",
      "position": [
        0,
        0
      ],
      "size": [
        64,
        32
      ],
      "hitTest": false
    }
  ]
}