{
  "type": "HBox",
  "name": "MapButtons",
  "anchor": "Fill",
  "spacing": 4,
  "align": "Fill",
  "children": [
    {
      "type": "Button",
      "name": "Overlays",
      "anchor": "Fill",
      "sprite": "MapButton",
      "action": "OpenOverlays",
      "tooltip": true,
      "bind": {
        "enabled": "map.overlays.enabled"
      },
      "children": [
        {
          "type": "Image",
          "anchor": "Top",
          "position": [
            0,
            0
          ],
          "size": [
            16,
            16
          ],
          "sprite": "Icon.Overlays",
          "color": "#75B9DF"
        },
        {
          "type": "Text",
          "text": "Overlays",
          "font": "Body",
          "fontSize": 14,
          "color": "#E6E9EE",
          "anchor": "BottomStretch",
          "position": [
            0,
            0
          ],
          "size": [
            0,
            18
          ],
          "align": "Center",
          "wrap": false,
          "maxLines": 1
        },
        {
          "type": "Image",
          "anchor": "TopRight",
          "position": [
            0,
            0
          ],
          "size": [
            10,
            10
          ],
          "sprite": "Icon.Lock",
          "color": "#E6E9EE",
          "visibleWhen": "!map.overlays.enabled"
        }
      ],
      "padding": [
        8,
        4,
        8,
        4
      ]
    },
    {
      "type": "Button",
      "name": "Objectives",
      "anchor": "Fill",
      "sprite": "MapButton",
      "action": "OpenObjectives",
      "tooltip": true,
      "bind": {
        "enabled": "map.objectives.enabled"
      },
      "children": [
        {
          "type": "Image",
          "anchor": "Top",
          "position": [
            0,
            0
          ],
          "size": [
            16,
            16
          ],
          "sprite": "Icon.Objectives",
          "color": "#75B9DF"
        },
        {
          "type": "Text",
          "text": "Objectives",
          "font": "Body",
          "fontSize": 14,
          "color": "#E6E9EE",
          "anchor": "BottomStretch",
          "position": [
            0,
            0
          ],
          "size": [
            0,
            18
          ],
          "align": "Center",
          "wrap": false,
          "maxLines": 1
        },
        {
          "type": "Image",
          "anchor": "TopRight",
          "position": [
            0,
            0
          ],
          "size": [
            10,
            10
          ],
          "sprite": "Icon.Lock",
          "color": "#E6E9EE",
          "visibleWhen": "!map.objectives.enabled"
        }
      ],
      "padding": [
        8,
        4,
        8,
        4
      ]
    }
  ]
}