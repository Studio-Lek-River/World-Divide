# Unreal generated
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
# The kit's derived manifest (Tools/Art/kit_blender.py) is committed; Build/ above matches its folder on Windows.
!Art/Shared/kit/build/
**/Plugins/*/Binaries/
**/Plugins/*/Intermediate/

# IDE
.vs/
.vscode/
.idea/
*.sln
*.slnx
.vsconfig
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Python
__pycache__/
*.pyc

# Blender's automatic backups (.blend1, .blend2, ...)
*.blend[0-9]

# Third-party marketplace packs: the repository is public and their licences forbid sharing the files, so each machine adds
# them from Fab and keeps them here (#153). The manifest is docs/world/maps/WD_RiverCrossing_01/01_ASSET_AUDIT.md.
Content/Deko_MatrixDemo/
Content/Megaplant_Library/
Content/StylizedBridge/
Content/Real_Stones_Pack_01/
Content/ProceduralBuildingGenerator/
Content/UltimateUIMenusSFX/
Content/HighPoly_Tree_Model/
Content/AdvancedRealisticGlass/
Content/Materials_StoneTiles/
Content/MeshRift_CW_MaterialPackSample/
Content/MuddyGroundPack/
Content/SM_Concrete_07/
Content/SM_Tiles_02/
Content/StylizedSurface_Lite/
Content/UnrealDrive_CitySample/
Content/AccuCities/
Content/FogArea/
# The scanned surfaces of ue.ps1 -Task surfaces (#330): Megascans source textures, rebuilt from the producer's ZIPs.
Content/Surfaces/
# Their one-file-per-actor data from the packs' demo levels.
Content/__ExternalActors__/AdvancedGlass/
Content/__ExternalActors__/AdvancedRealisticGlass/
Content/__ExternalObjects__/AdvancedRealisticGlass/
# The pack scale level of Tools/Editor/audit_packs.py: it references the packs above.
Content/Developers/PackAudit/
Content/Developers/KitSpike/
# The bench's HQ shells of #349 (ue.ps1 -Task setup -BenchHQ): large, rebuilt from Art/USA/buildings/usa_hq on each machine.
Content/Bench/

# A tryout model ripped from CryEngine content: Crytek's, kept on this machine only, never committed or shipped
Art/Source/Local/Crytek/
Content/Art/Local/**/*Abrams*
# World in Conflict's smoke flipbook and the muzzle smoke drawn with it (#355), from Tools/Art/wic_smoke_flipbook.py:
# Massive's, kept on this machine only, never committed or shipped
Art/Source/Local/WiC/
Content/Art/Local/**/*WiCSmoke*
Content/Art/Local/Effects/
